# Copy to .env beside docker-compose.prod.yml. Never commit the real one.
DOMAIN=time.example.com
POSTGRES_PASSWORD=
SECRET_KEY=

# Screenshots. Leave S3_BUCKET empty to store on the container's disk instead.
S3_BUCKET=
S3_PREFIX=
AWS_REGION=eu-west-1

# Reports. Leave SMTP_HOST empty and no mail is sent (and none is retried).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

DEFAULT_TIMEZONE=Africa/Nairobi
